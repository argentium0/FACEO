{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "rooms": {
      ".read": "auth != null",
      "$roomId": {
        ".read": "auth != null && (!data.hasChild('emptyAt') || now < data.child('emptyAt').val() + 300000)",
        ".write": "auth != null && (newData.val() == null || !data.hasChild('emptyAt') || now < data.child('emptyAt').val() + 300000)"
      }
    },
    "presence": {
      "$roomId": {
        ".read": "auth != null && (!root.child('rooms').child($roomId).hasChild('emptyAt') || now < root.child('rooms').child($roomId).child('emptyAt').val() + 300000)",
        ".write": "auth != null"
      }
    },
    "activeSpeaker": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
